# Model access
OPENROUTER_API_KEY=

# Kalshi market data
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_FILE=
# Alternatively provide the private key directly:
# KALSHI_PRIVATE_KEY_PEM=
# KALSHI_PRIVATE_KEY_B64=

# Persistence (optional locally; SQLite is used when omitted)
DATABASE_URL=

# Authentication
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# User Kalshi connections and order execution (server only; never set in Next.js)
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
KALSHI_CREDENTIALS_ENCRYPTION_KEY=
ENABLE_LIVE_TRADING=false

# Required to access diagnostic and maintenance endpoints via X-Prism-Admin-Key.
# Leave empty to disable those endpoints.
PRISM_ADMIN_API_KEY=

# API and cache behavior
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_CACHE_REFRESH_SCHEDULER=false
TRADING_COMPANION_CACHE_DIR=
# Retain the most liquid N markets from the complete non-combo catalog.
MARKET_CACHE_MAX_MARKETS=100000
MARKET_CACHE_MAX_SECONDS=1800
EVENT_CACHE_MAX_EVENTS=100000
EVENT_CACHE_MAX_SECONDS=900
KALSHI_API_LOG_FILE=runtime_logs/kalshi_api_log.csv
